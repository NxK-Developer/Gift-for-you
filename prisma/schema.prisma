
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { USER ADMIN }
enum TemplateType { SURPRISE INVITATION FLIPBOOK }
enum ProjectStatus { DRAFT READY_FOR_CHECKOUT PAYMENT_PENDING PAID PUBLISHED UNPUBLISHED EXPIRED DELETED }
enum PaymentStatus { PENDING SUCCESS FAILED REFUNDED }
enum AssetType { IMAGE VIDEO AUDIO }
enum DiscountType { PERCENT FLAT }

model User {
  id String @id @default(cuid())
  email String @unique
  phone String? @unique
  name String?
  role Role @default(USER)
  image String?
  createdAt DateTime @default(now())
  projects Project[]
  orders Order[]
  favorites Favorite[]
  supportTickets SupportTicket[]
}

model Category {
  id String @id @default(cuid())
  slug String @unique
  name String
  type TemplateType
  description String?
  image String?
  templates Template[]
}

model Template {
  id String @id @default(cuid())
  slug String @unique
  title String
  subtitle String
  description String @db.Text
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  type TemplateType
  occasion String[]
  rating Float @default(4.9)
  reviewCount Int @default(120)
  basePrice Int
  salePrice Int
  badge String?
  isFeatured Boolean @default(false)
  isTrending Boolean @default(false)
  isPremium Boolean @default(false)
  previewImage String
  demoUrl String?
  schema Json
  themePresets Json
  fontPresets Json
  validationRules Json?
  createdAt DateTime @default(now())
  projects Project[]
}

model Project {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  templateId String
  template Template @relation(fields: [templateId], references: [id])
  title String
  slug String @unique
  status ProjectStatus @default(DRAFT)
  content Json
  theme String @default("rose-blush")
  font String @default("playfair")
  isPasswordProtected Boolean @default(false)
  password String?
  isUnlisted Boolean @default(false)
  scheduledAt DateTime?
  expiresAt DateTime?
  views Int @default(0)
  shares Int @default(0)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets Asset[]
  order Order?
  analytics AnalyticsEvent[]
}

model Asset {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url String
  thumbnailUrl String?
  type AssetType
  order Int @default(0)
  size Int
  isPrivate Boolean @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  projectId String @unique
  project Project @relation(fields: [projectId], references: [id])
  amount Int
  razorpayOrderId String @unique
  razorpayPaymentId String?
  status PaymentStatus @default(PENDING)
  couponId String?
  coupon Coupon? @relation(fields: [couponId], references: [id])
  invoiceUrl String?
  createdAt DateTime @default(now())
}

model Coupon {
  id String @id @default(cuid())
  code String @unique
  discountType DiscountType
  value Int
  maxUses Int @default(100)
  usedCount Int @default(0)
  isActive Boolean @default(true)
  expiresAt DateTime?
  orders Order[]
}

model Favorite {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  templateId String
  createdAt DateTime @default(now())
  @@unique([userId, templateId])
}

model AnalyticsEvent {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type String
  metadata Json?
  createdAt DateTime @default(now())
}

model SupportTicket {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  subject String
  message String @db.Text
  status String @default("open")
  createdAt DateTime @default(now())
}

model HomepageSection {
  id String @id @default(cuid())
  key String @unique
  title String
  isEnabled Boolean @default(true)
  order Int
  config Json
}
